{
  "expo": {
    "name": "حمزاوي سات",
    "slug": "sonaa",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.sonaa.app",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F6F0"
      }
    },
    "extra": {
      "apiUrl": "https://sonaa-backend-v2.vercel.app/api",
      "eas": {
        "projectId": "01cd6ee6-73a2-4404-8381-d60446befcc5"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F0"
    },
    "owner": "sonaa2030",
    "plugins": [
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "السماح لحمزاوي سات بتسجيل وصف الطلب الصوتي."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ]
  }
}
